{
  "_readme": [
    "DRAFT flow definition — review aur badlav ke liye. Abhi koi code isko use nahi karta.",
    "",
    "RULES (WhatsApp ki hard limits, inhe tod nahi sakte):",
    "  • buttons: max 3 per screen. Zyada chahiye to 'type': 'list' use karein (max 10 rows).",
    "  • button title: max 20 characters.",
    "  • list rows: max 10 total; list ke saath image/video header NAHI chalta, sirf text.",
    "  • header.type: text | image | video | none. Media public URL se aayegi.",
    "  • Free-form interactive sirf 24h window ke andar. Uske baad approved template chahiye.",
    "",
    "SCREEN TYPES:",
    "  buttons  → header + body + up to 3 reply buttons",
    "  list     → text header + body + sections/rows",
    "  input    → user se text maangta hai (naam, city). Jawab 'action' ko jaata hai.",
    "  action   → backend kaam karta hai (search, analyse, feature trigger), phir 'next' par jaata hai",
    "",
    "MEDIA: <<<...>>> wale saare URL placeholder hain — aapko asli URL dene hain."
  ],

  "version": 1,
  "start": "WELCOME",
  "fallback": {
    "_note": "Button click na ho aur user text likhe to: AI jawab dega, phir wapas current screen ke buttons dikhega.",
    "use_ai": true,
    "reshow_current_screen": true
  },

  "screens": {

    "WELCOME": {
      "type": "buttons",
      "header": { "type": "image", "url": "<<<welcome-banner.png>>>" },
      "body": {
        "hi": "Namaste! 🙏 Main *Priya* hoon, Limbu.ai se.\n\nMain aapke Google Business ko top par laane mein madad karti hoon — zyada customers, zyada reviews.\n\nKya karna chahenge?",
        "en": "Hello! 🙏 I'm *Priya* from Limbu.ai.\n\nI help your Google Business rank higher — more customers, more reviews.\n\nWhat would you like to do?"
      },
      "footer": { "hi": "Limbu.ai", "en": "Limbu.ai" },
      "buttons": [
        { "id": "CONNECT_START", "title": { "hi": "Business jodein", "en": "Add business" }, "next": "ASK_BUSINESS" },
        { "id": "SHOW_PLANS",    "title": { "hi": "Plans dekhein",   "en": "See plans" },    "next": "PLANS" },
        { "id": "MAIN_MENU",     "title": { "hi": "Aur jaanein",     "en": "More" },         "next": "MAIN_MENU" }
      ]
    },

    "MAIN_MENU": {
      "type": "list",
      "header": { "type": "text", "text": { "hi": "Limbu.ai Menu", "en": "Limbu.ai Menu" } },
      "body": {
        "hi": "Kya dekhna chahenge?",
        "en": "What would you like to see?"
      },
      "list_button": { "hi": "Menu kholein", "en": "Open menu" },
      "sections": [
        {
          "title": { "hi": "Aapka business", "en": "Your business" },
          "rows": [
            { "id": "CONNECT_START", "title": { "hi": "Business jodein", "en": "Add business" },
              "description": { "hi": "Google profile connect karein", "en": "Connect Google profile" }, "next": "ASK_BUSINESS" },
            { "id": "FREE_FEATURES", "title": { "hi": "FREE features", "en": "FREE features" },
              "description": { "hi": "Health report, QR, website", "en": "Health report, QR, website" }, "next": "CONNECTED_MENU" }
          ]
        },
        {
          "title": { "hi": "Limbu.ai ke baare mein", "en": "About Limbu.ai" },
          "rows": [
            { "id": "SHOW_PLANS",    "title": { "hi": "Plans aur price", "en": "Plans & pricing" },
              "description": { "hi": "₹2,500/month se shuru", "en": "Starting ₹2,500/month" }, "next": "PLANS" },
            { "id": "FRANCHISE_INFO","title": { "hi": "Franchise lein", "en": "Franchise" },
              "description": { "hi": "₹1L-₹3L/month kamayein", "en": "Earn ₹1L-₹3L/month" }, "next": "FRANCHISE_INFO" },
            { "id": "SUPPORT",       "title": { "hi": "Baat karein", "en": "Talk to us" },
              "description": { "hi": "Hamari team se baat karein", "en": "Talk to our team" }, "next": "SUPPORT" }
          ]
        }
      ]
    },

    "ASK_BUSINESS": {
      "type": "input",
      "body": {
        "hi": "Apna *business ka naam* aur *city* likh dijiye.\n\nJaise: _Sharma Sweets, Gurgaon_",
        "en": "Please type your *business name* and *city*.\n\nExample: _Sharma Sweets, Gurgaon_"
      },
      "expect": "business_name_city",
      "action": "SEARCH_BUSINESS",
      "next": "CONFIRM_BUSINESS",
      "on_not_found": "BUSINESS_NOT_FOUND"
    },

    "CONFIRM_BUSINESS": {
      "type": "buttons",
      "_note": "body backend se banega — business ka naam, address, rating.",
      "header": { "type": "text", "text": { "hi": "Yeh mila", "en": "Found this" } },
      "body": { "hi": "{{business_card}}\n\nKya yeh aapka business hai?", "en": "{{business_card}}\n\nIs this your business?" },
      "buttons": [
        { "id": "BIZ_YES",  "title": { "hi": "Haan, yahi hai", "en": "Yes, that's it" }, "next": "ANALYSE_REPORT" },
        { "id": "BIZ_NEXT", "title": { "hi": "Nahi, doosra",   "en": "No, next one" },   "next": "CONFIRM_BUSINESS", "action": "NEXT_RESULT" },
        { "id": "BIZ_RETRY","title": { "hi": "Dobara likhoon", "en": "Type again" },     "next": "ASK_BUSINESS" }
      ]
    },

    "BUSINESS_NOT_FOUND": {
      "type": "buttons",
      "body": {
        "hi": "Yeh business Google par nahi mila. 😔\n\nHo sakta hai profile bani hi na ho — hum bana sakte hain.",
        "en": "Couldn't find this business on Google. 😔\n\nMaybe the profile doesn't exist yet — we can create it."
      },
      "buttons": [
        { "id": "BIZ_RETRY", "title": { "hi": "Dobara likhoon", "en": "Type again" }, "next": "ASK_BUSINESS" },
        { "id": "SUPPORT",   "title": { "hi": "Baat karein",    "en": "Talk to us" }, "next": "SUPPORT" }
      ]
    },

    "ANALYSE_REPORT": {
      "type": "action",
      "action": "ANALYSE",
      "_note": "GMB health score 0-100 nikaalta hai, report bhejta hai, phir CONNECT_OFFER par jaata hai.",
      "next": "CONNECT_OFFER"
    },

    "CONNECT_OFFER": {
      "type": "buttons",
      "header": { "type": "image", "url": "<<<connect-benefits.png>>>" },
      "body": {
        "hi": "Aapki profile ka score: *{{score}}/100*\n\nGoogle profile connect karein to main yeh sab *FREE* mein kar dungi:\n✅ Health report\n✅ Magic QR (reviews laata hai)\n✅ Free website",
        "en": "Your profile score: *{{score}}/100*\n\nConnect your Google profile and I'll do all this *FREE*:\n✅ Health report\n✅ Magic QR (brings reviews)\n✅ Free website"
      },
      "buttons": [
        { "id": "CONNECT_GO",  "title": { "hi": "Connect karein", "en": "Connect now" }, "next": "CONNECT_LINK" },
        { "id": "SHOW_PLANS",  "title": { "hi": "Pehle plans",    "en": "Plans first" }, "next": "PLANS" },
        { "id": "SUPPORT",     "title": { "hi": "Sawaal hai",     "en": "I have a question" }, "next": "SUPPORT" }
      ]
    },

    "CONNECT_LINK": {
      "type": "action",
      "action": "SEND_CONNECT_LINK",
      "_note": "Connect link bhejta hai + connection polling start karta hai. Connect hote hi CONNECTED_MENU push hoga.",
      "next": "CONNECT_PENDING"
    },

    "CONNECT_PENDING": {
      "type": "buttons",
      "body": {
        "hi": "Link bhej di hai 👆\n\nGoogle account se login karke *Allow* dabayein. Ho jaane par mujhe bata dijiye.",
        "en": "Link sent 👆\n\nLog in with Google and tap *Allow*. Let me know once done."
      },
      "buttons": [
        { "id": "CONNECT_CHECK", "title": { "hi": "Ho gaya, check karo", "en": "Done, check it" }, "next": "CONNECTED_MENU", "action": "CHECK_CONNECTION" },
        { "id": "CONNECT_HELP",  "title": { "hi": "Problem aa rahi",    "en": "Having trouble" },  "next": "SUPPORT" }
      ]
    },

    "CONNECTED_MENU": {
      "type": "list",
      "header": { "type": "text", "text": { "hi": "FREE Features", "en": "FREE Features" } },
      "body": {
        "hi": "Connect ho gaya! ✅\n\nYeh sab *bilkul FREE* hai — kya chahiye?",
        "en": "Connected! ✅\n\nAll of this is *completely FREE* — what would you like?"
      },
      "list_button": { "hi": "Feature chunein", "en": "Pick a feature" },
      "sections": [
        {
          "title": { "hi": "Free features", "en": "Free features" },
          "rows": [
            { "id": "F_HEALTH",  "title": { "hi": "Health Report", "en": "Health Report" },
              "description": { "hi": "Poori profile ka analysis", "en": "Full profile analysis" }, "next": "FEATURE_RUN" },
            { "id": "F_QR",      "title": { "hi": "Magic QR Code", "en": "Magic QR Code" },
              "description": { "hi": "Apne aap reviews laata hai", "en": "Collects reviews automatically" }, "next": "FEATURE_RUN" },
            { "id": "F_INSIGHTS","title": { "hi": "Google Insights", "en": "Google Insights" },
              "description": { "hi": "Performance data", "en": "Performance data" }, "next": "FEATURE_RUN" },
            { "id": "F_WEBSITE", "title": { "hi": "Free Website", "en": "Free Website" },
              "description": { "hi": "Bilkul free, koi charge nahi", "en": "Totally free, no charge" }, "next": "FEATURE_RUN" },
            { "id": "F_REVIEWS", "title": { "hi": "Review Reply", "en": "Review Reply" },
              "description": { "hi": "AI reviews ka jawab dega", "en": "AI replies to your reviews" }, "next": "FEATURE_RUN" }
          ]
        },
        {
          "title": { "hi": "Aage badhein", "en": "Go further" },
          "rows": [
            { "id": "SHOW_PLANS", "title": { "hi": "Plans dekhein", "en": "See plans" },
              "description": { "hi": "₹2,500/month se", "en": "From ₹2,500/month" }, "next": "PLANS" }
          ]
        }
      ]
    },

    "FEATURE_RUN": {
      "type": "action",
      "action": "TRIGGER_FEATURE",
      "_note": "Button id (F_HEALTH etc) se feature decide hoga. Result deliver hone ke baad FEATURE_DONE.",
      "feature_map": {
        "F_HEALTH": "health_score",
        "F_QR": "magic_qr",
        "F_INSIGHTS": "insights",
        "F_WEBSITE": "website",
        "F_REVIEWS": "review_reply"
      },
      "next": "FEATURE_DONE"
    },

    "FEATURE_DONE": {
      "type": "buttons",
      "body": {
        "hi": "Ho gaya! ✅\n\nAur kuch dekhna hai?",
        "en": "Done! ✅\n\nAnything else?"
      },
      "buttons": [
        { "id": "FREE_FEATURES", "title": { "hi": "Aur features", "en": "More features" }, "next": "CONNECTED_MENU" },
        { "id": "SHOW_PLANS",    "title": { "hi": "Plans dekhein", "en": "See plans" },    "next": "PLANS" },
        { "id": "SUPPORT",       "title": { "hi": "Baat karein",   "en": "Talk to us" },   "next": "SUPPORT" }
      ]
    },

    "PLANS": {
      "type": "list",
      "header": { "type": "text", "text": { "hi": "Limbu.ai Plans", "en": "Limbu.ai Plans" } },
      "body": {
        "hi": "Saare plans mein GST alag se lagta hai.\nYearly lene par *20% discount*.",
        "en": "GST applies on all plans.\n*20% off* on yearly."
      },
      "list_button": { "hi": "Plan chunein", "en": "Choose a plan" },
      "sections": [
        {
          "title": { "hi": "Monthly plans", "en": "Monthly plans" },
          "rows": [
            { "id": "PLAN_BASIC",   "title": { "hi": "Basic ₹2,500", "en": "Basic ₹2,500" },
              "description": { "hi": "15 posts, 5 citations", "en": "15 posts, 5 citations" }, "next": "PLAN_DETAIL" },
            { "id": "PLAN_PRO",     "title": { "hi": "Professional ₹5,500", "en": "Professional ₹5,500" },
              "description": { "hi": "30 posts, 12 citations", "en": "30 posts, 12 citations" }, "next": "PLAN_DETAIL" },
            { "id": "PLAN_PREMIUM", "title": { "hi": "Premium ₹7,500", "en": "Premium ₹7,500" },
              "description": { "hi": "45 posts, 15 citations", "en": "45 posts, 15 citations" }, "next": "PLAN_DETAIL" }
          ]
        }
      ]
    },

    "PLAN_DETAIL": {
      "type": "buttons",
      "_note": "body backend se banega — plans API ya default se. Price sirf yahin se aayegi, kahin hardcode nahi.",
      "header": { "type": "image", "url": "<<<plan-{{plan_key}}.png>>>" },
      "body": { "hi": "{{plan_card}}", "en": "{{plan_card}}" },
      "buttons": [
        { "id": "PLAN_BUY",  "title": { "hi": "Abhi lein",     "en": "Buy now" },    "next": "PLAN_PAY", "action": "SEND_PAYMENT_LINK" },
        { "id": "SHOW_PLANS","title": { "hi": "Doosra plan",   "en": "Other plans" },"next": "PLANS" },
        { "id": "SUPPORT",   "title": { "hi": "Baat karein",   "en": "Talk to us" }, "next": "SUPPORT" }
      ]
    },

    "PLAN_PAY": {
      "type": "buttons",
      "body": {
        "hi": "Payment link bhej di hai 👆\n\nPayment ke baad sab kuch apne aap chalu ho jaayega.",
        "en": "Payment link sent 👆\n\nEverything activates automatically after payment."
      },
      "buttons": [
        { "id": "SUPPORT", "title": { "hi": "Madad chahiye", "en": "Need help" }, "next": "SUPPORT" }
      ]
    },

    "FRANCHISE_INFO": {
      "type": "buttons",
      "header": { "type": "video", "url": "<<<franchise-pitch.mp4>>>" },
      "body": {
        "hi": "*Limbu.ai Franchise*\n\n💰 Fee: ₹5,00,000 + 18% GST (one-time)\n📈 Kamai: ₹1L-₹3L/month\n🤝 50% revenue share\n⏱️ ROI: 4-6 mahine\n🏠 Ghar se, 3-4 ghante roz\n\nApne city ke exclusive rights milte hain.",
        "en": "*Limbu.ai Franchise*\n\n💰 Fee: ₹5,00,000 + 18% GST (one-time)\n📈 Earn: ₹1L-₹3L/month\n🤝 50% revenue share\n⏱️ ROI: 4-6 months\n🏠 From home, 3-4 hrs/day\n\nExclusive rights for your city."
      },
      "buttons": [
        { "id": "FR_REGISTER", "title": { "hi": "Interested hoon", "en": "I'm interested" }, "next": "FRANCHISE_REGISTER" },
        { "id": "SUPPORT",     "title": { "hi": "Sawaal hai",      "en": "I have questions" }, "next": "SUPPORT" },
        { "id": "MAIN_MENU",   "title": { "hi": "Wapas menu",      "en": "Back to menu" },   "next": "MAIN_MENU" }
      ]
    },

    "FRANCHISE_REGISTER": {
      "type": "input",
      "body": {
        "hi": "Bahut achha! 🎉\n\nApna *naam* aur *city* likh dijiye. Team 24 ghante mein call karegi.",
        "en": "Great! 🎉\n\nPlease type your *name* and *city*. Our team will call within 24 hours."
      },
      "expect": "name_city",
      "action": "REGISTER_FRANCHISE",
      "next": "FRANCHISE_DONE",
      "on_error": "FRANCHISE_FAILED"
    },

    "FRANCHISE_DONE": {
      "type": "buttons",
      "body": {
        "hi": "Registration ho gaya! ✅\n\nHamari team 24 ghante mein aapko call karegi.\n📞 9289344726",
        "en": "Registered! ✅\n\nOur team will call you within 24 hours.\n📞 9289344726"
      },
      "buttons": [
        { "id": "MAIN_MENU", "title": { "hi": "Wapas menu", "en": "Back to menu" }, "next": "MAIN_MENU" }
      ]
    },

    "FRANCHISE_FAILED": {
      "_note": "ZAROORI: purana code fail hone par bhi 'ho gaya' bolta tha — lead chup-chaap gayab. Ab sach bolega.",
      "type": "buttons",
      "body": {
        "hi": "Maafi chahti hoon, registration save nahi ho paaya. 😔\n\nKripya seedha call karein — aapki detail le lenge:\n📞 9289344726",
        "en": "Sorry, the registration didn't save. 😔\n\nPlease call us directly and we'll take your details:\n📞 9289344726"
      },
      "buttons": [
        { "id": "FR_REGISTER", "title": { "hi": "Dobara try karein", "en": "Try again" }, "next": "FRANCHISE_REGISTER" }
      ]
    },

    "SUPPORT": {
      "type": "buttons",
      "body": {
        "hi": "Hamari team se baat karein:\n📞 9289344726\n✉️ info@limbu.ai\n\nYa yahin apna sawaal likh dijiye — main jawab dungi.",
        "en": "Talk to our team:\n📞 9289344726\n✉️ info@limbu.ai\n\nOr just type your question here — I'll answer."
      },
      "buttons": [
        { "id": "MAIN_MENU", "title": { "hi": "Wapas menu", "en": "Back to menu" }, "next": "MAIN_MENU" }
      ]
    }

  }
}
